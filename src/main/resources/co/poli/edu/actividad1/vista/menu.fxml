<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.poli.edu.actividad1.controlador.Controladormenu"
            prefHeight="780.0" prefWidth="951.0">

    <children>

        <!-- Campos principales -->
        <Label layoutX="101.0" layoutY="25.0" prefHeight="34.0" prefWidth="286.0"
               text="Ingrese la siguiente información">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <TextField fx:id="txt1" layoutX="47.0" layoutY="90.0" promptText="Id"/>
        <TextField fx:id="txt2" layoutX="287.0" layoutY="90.0" promptText="País"/>
        <TextField fx:id="txt3" layoutX="287.0" layoutY="138.0" promptText="Misión"/>

        <SplitMenuButton fx:id="split" layoutX="47.0" layoutY="138.0" mnemonicParsing="false"
                         prefHeight="26.0" prefWidth="150.0" text="Tipo de pasaporte">
            <items>
                <MenuItem fx:id="opt1" mnemonicParsing="false" onAction="#select" text="Diplomático"/>
                <MenuItem fx:id="opt2" mnemonicParsing="false" onAction="#select" text="Ordinario"/>
                <MenuItem fx:id="opt3" mnemonicParsing="false" onAction="#select" text="Emergencia"/>
            </items>
        </SplitMenuButton>

        <Label layoutX="119.0" layoutY="195.0" prefHeight="34.0" prefWidth="244.0"
               text="¿Qué acción desea realizar?">
            <font>
                <Font size="20.0"/>
            </font>
        </Label>

        <!-- Botones CRUD -->
        <Button fx:id="btt1" layoutX="46.0" layoutY="252.0" mnemonicParsing="false"
                onAction="#Click" prefHeight="26.0" prefWidth="134.0" text="Crear pasaporte"/>
        <Button fx:id="btt2" layoutX="193.0" layoutY="295.0" mnemonicParsing="false"
                onAction="#Click" prefHeight="26.0" prefWidth="134.0" text="Actualizar pasaporte"/>
        <Button fx:id="btt3" layoutX="196.0" layoutY="252.0" mnemonicParsing="false"
                onAction="#Click" prefHeight="26.0" prefWidth="126.0" text="Eliminar pasaporte"/>
        <Button fx:id="btt4" layoutX="46.0" layoutY="295.0" mnemonicParsing="false"
                onAction="#Click" prefHeight="26.0" prefWidth="134.0" text="Consultar pasaporte"/>
        <Button fx:id="btt5" layoutX="46.0" layoutY="337.0" mnemonicParsing="false"
                onAction="#Click" prefHeight="26.0" prefWidth="134.0" text="Consultar todos"/>

        <!-- Árbol de países -->
        <TreeView fx:id="treePaises" layoutX="707.0" layoutY="68.0" prefHeight="240.0" prefWidth="222.0"/>
        <Button fx:id="btt6" layoutX="547.0" layoutY="77.0" mnemonicParsing="false"
                onAction="#Click" prefHeight="26.0" prefWidth="134.0" text="Tree"/>

        <!-- Memento -->
        <Button fx:id="btt7" layoutX="569.0" layoutY="418.0" mnemonicParsing="false"
                onAction="#Click" text="Guardar"/>
        <Button fx:id="btt8" layoutX="573.0" layoutY="494.0" mnemonicParsing="false"
                onAction="#Click" text="Restaurar"/>
        <ListView fx:id="flist" layoutX="707.0" layoutY="363.0" prefHeight="240.0" prefWidth="222.0"/>
        <Button fx:id="btt9" layoutX="576.0" layoutY="560.0" mnemonicParsing="false"
                onAction="#Click" text="Mostrar"/>

        <!-- Otras acciones -->
        <Button fx:id="bttCommand" layoutX="100.0" layoutY="573.0" mnemonicParsing="false"
                onAction="#Click" text="Visa"/>
        <Button fx:id="btt10" layoutX="203.0" layoutY="572.0" mnemonicParsing="false"
                onAction="#Click" prefHeight="26.0" prefWidth="114.0" text="Valor pasaporte"/>

        <!-- ============================ -->
        <!-- SECCIÓN DE MENSAJERÍA ENTRE ENTIDADES -->
        <!-- ============================ -->
        <Label text="Mensajería entre entidades" layoutX="40" layoutY="630"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <ComboBox fx:id="comboEmisor" layoutX="40" layoutY="670" prefWidth="160"/>
        <ComboBox fx:id="comboReceptor" layoutX="220" layoutY="670" prefWidth="160"/>
        <TextField fx:id="txtMensaje" layoutX="40" layoutY="710" prefWidth="340"
                   promptText="Escribe un mensaje..."/>
        <Button fx:id="bttEnviar" layoutX="390" layoutY="710" text="Enviar"
                onAction="#enviarMensajePersonalizado"/>
        <TextArea fx:id="txtHistorial" layoutX="40" layoutY="750" prefWidth="440"
                  prefHeight="180" editable="false" wrapText="true"/>

    </children>
</AnchorPane>
